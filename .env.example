# Copy to .env and adjust. Container-internal ports never change here — these are
# only the host-side mappings, useful when the defaults are already in use.

# Host port overrides (defaults shown are the services' native ports)
LABEL_STUDIO_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
WANDB_PORT=8080
ML_BACKEND_PORT=9090
WEBHOOK_PORT=9091

# Label Studio must know its externally reachable URL (match LABEL_STUDIO_PORT).
LABEL_STUDIO_HOST=http://localhost:8080

# MinIO credentials (change for anything non-local).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Self-hosted W&B Server.
WANDB_HOST=http://localhost:8080      # external URL for generated links (match WANDB_PORT)
WANDB_BASE_URL=http://wandb:8080      # how in-network clients (miner) reach the server
WANDB_API_KEY=                        # create a user in the W&B UI, then paste its key
# WANDB_LICENSE=                      # optional: unlocks full W&B Server features

# Stays offline until WANDB_API_KEY is set and this is flipped to online.
WANDB_MODE=offline
WANDB_PROJECT=cv-fp-mining-lab

# Static image server for Label Studio task images.
FILESERVER_PORT=18090

# Optional real-data Docker build override for CUDA-specific Torch wheels.
# Example for CUDA 12.8 wheels:
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
TORCH_INDEX_URL=
